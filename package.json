{
  "name": "gpu-to-atom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Scroll-driven 3D teardown of an NVIDIA-style GPU, from graphics card down to a single silicon atom.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test smoke guided descent i18n pwa",
    "bench": "vite build && BENCH=${BENCH:-local} playwright test bench",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench:compare": "node scripts/compare-bench.mjs bench/baseline.json bench/after.json > bench/comparison.md"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lil-gui": "^0.21.0",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
